// Schema inicial — ponto de partida, evoluído a partir do handoff em /claude-code-handoff/prisma/schema.prisma.
// Foco no MVP: Clinica, Profissional, Paciente, Teste (fixo+custom), AplicacaoDeTeste, Laudo.
// Módulos de Agenda/Convênio/Faturamento entram numa V2 (campos já deixados previstos onde fizer sentido).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EscopoTeste {
  FIXO
  CUSTOM
}

// Sexo biológico do paciente — necessário porque várias tabelas normativas (ex: ETDAH-PAIS,
// SCARED, BFP) são estratificadas por sexo, não só por idade. Opcional: não travar o cadastro
// de pacientes existentes nem obrigar preenchimento em testes que não precisam dele.
enum Sexo {
  MASCULINO
  FEMININO
}

// Quem produziu os escores de uma AplicacaoDeTeste.
//
// Boa parte dos instrumentos não é aplicada NO paciente: é um questionário que outra pessoa
// responde SOBRE ele (BRIEF2, SCARED, SRS-2, Vineland, CBCL, ETDAH...). E o mesmo paciente pode
// ser avaliado por várias pessoas ao mesmo tempo — mãe, pai, dois professores e, se tiver idade,
// ele próprio. A diferença entre os respondentes é achado clínico, não ruído: mãe acusando
// sintoma severo com professores achando normal aponta para algo específico do contexto familiar.
//
// PACIENTE é o default e cobre tanto autorrelato quanto teste de aplicação direta (WISC-IV,
// RAVLT), onde não existe informante — o dado é do paciente, registrado pelo examinador.
//
// A lista cobre avaliação infantil, de adulto e de idoso de propósito. Mãe/pai/professor dão
// conta da prática infantil, mas numa avaliação de adulto o informante padrão é o CÔNJUGE, e em
// investigação de demência costuma ser um FILHO adulto — fixar só os papéis da clínica infantil
// deixaria metade da neuropsicologia de fora. OUTRO + `respondenteRelacao` (texto livre) cobre
// o que não couber aqui.
enum TipoRespondente {
  PACIENTE
  MAE
  PAI
  CONJUGE
  FILHO
  IRMAO
  CUIDADOR
  PROFESSOR
  PROFISSIONAL
  OUTRO
}

enum DominioCognitivo {
  INTELIGENCIA
  ATENCAO
  MEMORIA
  FUNCOES_EXECUTIVAS
  LINGUAGEM_APRENDIZAGEM
  PERSONALIDADE
  SINTOMAS_EMOCIONAIS
  RASTREIO_TDAH
  RASTREIO_TEA
  DESENVOLVIMENTO
  OUTRO
}

enum StatusLaudo {
  RASCUNHO_IA
  EM_REVISAO
  FINALIZADO
  ENTREGUE
}

enum PapelProfissional {
  ADMIN
  PSICOLOGO
}

// Sistema é usado por várias clínicas/profissionais, não só quem forneceu os laudos de
// referência — quando existe mais de uma convenção reconhecida na área para o mesmo tipo de
// classificação, o sistema oferece todas como opção ao invés de fixar uma como "a certa"
// (ver memória do projeto feedback_multiplos_sistemas_classificacao_livre_escolha).
enum SistemaClassificacaoPercentil {
  GUILMETTE_2020
  MIOTTO_2017
}

// Ver comentário em Teste.direcao.
enum DirecaoMelhorPior {
  MAIOR_MELHOR
  MENOR_MELHOR
  NEUTRO
}

model Clinica {
  id            String         @id @default(uuid())
  razaoSocial   String
  nomeFantasia  String?        // nome usado em qualquer exibição no sistema, exceto NFS-e (que exige razão social)
  cnpj          String?
  endereco      String?        // logradouro + número
  bairro        String?
  cidade        String?
  estado        String?        // UF, 2 letras
  cep           String?
  telefone      String?
  logoUrl       String?        @db.Text // URL ou data URL de imagem (logotipo do papel timbrado)
  marcaDaguaUrl String?        @db.Text // imagem de fundo (marca-d'água) do papel timbrado
  slogan        String?        // frase do cabeçalho do laudo
  instagram     String?
  whatsapp      String?
  corPrimaria   String?        // hex, para personalizar laudo/portal
  corSecundaria String?
  criadoEm      DateTime       @default(now())

  profissionais      Profissional[]
  pacientes          Paciente[]
  convenios          Convenio[]
  tiposAtendimento   TipoAtendimento[]
  normativasCustomizadas NormativaCustomizada[]
  modelosLaudo       ModeloLaudo[]
  modeloLaudoPadraoId String?      // modelo de laudo padrão da clínica (vale para quem não escolheu o seu)
  configFiscal       ConfigFiscal?
  planoVideo         String        @default("BASICO") // BASICO (videochamada, sem gravação) | COMPLETO (consentimento, gravação cifrada, transcrição e resumo)
  notasFiscais       NotaFiscal[]
}

model Profissional {
  id                String            @id @default(uuid())
  clinicaId         String
  clinica           Clinica           @relation(fields: [clinicaId], references: [id])

  nome              String
  fotoUrl           String?
  // assinatura escaneada/desenhada (data URL de imagem), usada no fecho do laudo; fica de fora das listas (ver profissionais.routes)
  assinaturaUrl     String?           @db.Text
  tituloLaudo       String?           // linha sob o nome no fecho do laudo (ex.: "Psicóloga especialista em Neuropsicologia")
  crp               String
  telefone          String?
  enderecoParticular String?
  formacao          String?           // texto livre: pós-graduações (legado — ver `especialidades` para lista estruturada)
  especialidades    String[]          @default([])
  papel             PapelProfissional @default(PSICOLOGO)
  email             String            @unique
  senhaHash         String

  perfilDeAtuacao   PerfilDeAtuacao?
  pacientes         Paciente[]
  sessoes           Sessao[]
  laudos            Laudo[]
  modelosLaudo      ModeloLaudo[]
  modeloLaudoPadraoId String?        // modelo de laudo padrão deste profissional
  testesCriados     Teste[]           @relation("TestesCriadosPeloProfissional")
  convenios         ProfissionalConvenio[]
  eventosAgenda     EventoAgenda[]

  criadoEm          DateTime          @default(now())
}

// "System prompt" clínico do profissional, usado para orientar a IA na síntese do laudo
model PerfilDeAtuacao {
  id                    String       @id @default(uuid())
  profissionalId        String       @unique
  profissional          Profissional @relation(fields: [profissionalId], references: [id])

  abordagemTeorica       String?     @db.Text
  tomDeEscrita            String?    @db.Text  // ex: "técnico porém acessível ao leigo"
  regrasDePrudencia       String?    @db.Text  // ex: "nunca fechar TEA sem encaminhar avaliação médica"
  vocabularioRecorrente   String?    @db.Text
  laudosExemplo           Json?      // array de textos de laudos anteriores, para few-shot

  // Qual referência usar para a tabela de classificação por percentil no laudo DOCX — mais de
  // uma convenção é usada na prática por profissionais diferentes, então isto é uma escolha
  // do profissional, não um padrão fixo do sistema.
  sistemaClassificacaoPercentil SistemaClassificacaoPercentil @default(GUILMETTE_2020)

  // Respostas estruturadas (opção pré-definida + complemento livre) a um catálogo de perguntas
  // definido em código (não no banco) — técnicas e pessoais (para uso interno de qualificação
  // profissional↔paciente). Formato: { [perguntaId]: { opcao: string, complemento?: string } }
  respostas               Json?

  atualizadoEm            DateTime   @updatedAt
}

model Paciente {
  id              String     @id @default(uuid())
  clinicaId       String
  clinica         Clinica    @relation(fields: [clinicaId], references: [id])
  profissionalId  String
  profissional    Profissional @relation(fields: [profissionalId], references: [id])

  nome            String
  dataNascimento  DateTime
  sexo            Sexo?
  fotoUrl         String?
  responsavelLegal String?
  cpf             String?    // identificação do laudo (formato 000.000.000-00)
  contato         String?
  escolaridade    String?

  convenioId      String?
  convenio        Convenio?  @relation(fields: [convenioId], references: [id])
  convenioNumeroCarteira String?   // número da carteirinha
  convenioPlano          String?   // ex: "Amil 400", "Bradesco Saúde Nacional"
  convenioValidade       DateTime? // validade da carteirinha
  convenioTitular        String?   // quando o paciente é dependente: nome do titular do plano
  // nota fiscal deste paciente: vazio = vale o padrão da clínica (ConfigFiscal)
  nfModo         String?   // POR_SESSAO | POR_LAUDO | MANUAL | NAO_EMITE
  nfQuando       String?   // NA_COBRANCA | NA_BAIXA | MANUAL
  nfEmNomeDe     String?   // PACIENTE | RESPONSAVEL | OUTRO (quem aparece como tomador na nota)
  nfTomadorNome  String?
  nfTomadorDocumento String?
  nfTomadorEmail String?

  anamnese        Json?      // estrutura livre: queixa, histórico escolar/médico/familiar
  preferenciasAgenda Json?   // melhores dias/horários do paciente para agendamento
  anexos          Anexo[]
  cobrancas       Cobranca[]
  sessoes         Sessao[]
  laudos          Laudo[]
  eventosAgenda   EventoAgenda[]

  // Conformidade Resolução CFP nº 09/2024: paciente deve ser informado sobre
  // recursos tecnológicos usados (incluindo IA) e, no caso de IA, idealmente consentir
  consentimentoTDIC       Boolean   @default(false)
  consentimentoTDICData   DateTime?

  criadoEm        DateTime   @default(now())
}

model Anexo {
  id          String    @id @default(uuid())
  pacienteId  String
  paciente    Paciente  @relation(fields: [pacienteId], references: [id])
  tipo        String    // "foto" | "documento" | "laudo_externo" | "exame"
  url         String
  descricao   String?
  criadoEm    DateTime  @default(now())
}

model Sessao {
  id              String    @id @default(uuid())
  pacienteId      String
  paciente        Paciente  @relation(fields: [pacienteId], references: [id])
  profissionalId  String
  profissional    Profissional @relation(fields: [profissionalId], references: [id])

  dataHora        DateTime
  tipo            String    @default("AVALIACAO") // AVALIACAO | ANAMNESE (a anamnese é uma sessão, com horário próprio no mesmo dia)
  observacoes     String?   @db.Text
  aplicacoesTeste AplicacaoDeTeste[]
  salasVirtuais   SalaVirtual[]
  eventoAgenda    EventoAgenda?
  cobrancas       Cobranca[]

  criadoEm        DateTime  @default(now())
}

// Compromisso de agenda lançado manualmente (avaliação ou qualquer outro atendimento).
// Distinto de Sessao: Sessao é o registro clínico de uma sessão de avaliação já realizada
// (usada pelo motor de correção); EventoAgenda é o agendamento em si, passado ou futuro.
model EventoAgenda {
  id              String       @id @default(uuid())
  profissionalId  String
  profissional    Profissional @relation(fields: [profissionalId], references: [id])
  pacienteId      String?
  paciente        Paciente?    @relation(fields: [pacienteId], references: [id])

  // Quando o evento nasceu do cronograma de um atendimento, aponta para a Sessao correspondente;
  // mudar o horário do evento move também a Sessao.dataHora.
  sessaoId        String?      @unique
  sessao          Sessao?      @relation(fields: [sessaoId], references: [id])

  titulo          String
  tipo            String       // "avaliacao" | "outro" — texto livre por enquanto
  inicio          DateTime
  fim             DateTime
  observacoes     String?      @db.Text

  criadoEm        DateTime     @default(now())
}

// Catálogo de testes — fixo (seed) ou custom (cadastrado por um profissional)
model Teste {
  id                        String            @id @default(uuid())
  nome                      String
  sigla                     String
  dominio                   DominioCognitivo
  escopo                    EscopoTeste
  criadoPorProfissionalId   String?
  criadoPorProfissional     Profissional?     @relation("TestesCriadosPeloProfissional", fields: [criadoPorProfissionalId], references: [id])

  descricao                 String?           @db.Text
  algoritmoCorrecao         Json              // definição estruturada: itens, subtestes, fórmula de escore bruto
  referenciaBibliografica   String?           @db.Text

  // Chave do INSTRUMENTO ao qual este teste pertence (ex: "SCARED", "BRIEF2").
  //
  // Vários instrumentos têm mais de um formulário — Pais, Professores, Autorrelato — e cada
  // formulário tem tabela normativa PRÓPRIA. Por isso cada formulário é um Teste separado no
  // catálogo (SCARED-PAIS e SCARED-AUTORRELATO são duas linhas), o que mantém a seleção de norma
  // simples: continua sendo idade + sexo, sem um terceiro eixo.
  //
  // O custo dessa escolha é que, sem mais nada, o sistema não sabe que as duas linhas são o mesmo
  // instrumento sobre a mesma pessoa — e comparar mãe × professor fica impossível de fazer
  // automaticamente. Este campo é o que amarra as duas de volta. Nulo em teste CUSTOM e em
  // instrumento de formulário único.
  instrumento               String?

  // Trava de dados provisórios (MVP): testes semeados antes da lista definitiva da psicóloga
  // chegam com isPlaceholder=true. Nunca usar em laudo real — ver regras de bloqueio em Laudo.
  isPlaceholder             Boolean           @default(false)
  // Permite desativar/substituir um teste (ex: trocar placeholder pelo instrumento real)
  // sem apagar histórico: AplicacaoDeTeste continua referenciando o testeId original.
  ativo                     Boolean           @default(true)

  // Direção de "melhor resultado" — usado só para decidir a cor (verde/vermelho) no gráfico do
  // resultado no frontend; nunca para alterar o cálculo em si. Default NEUTRO (sem julgamento de
  // cor) é proposital: testes ainda não revisados não devem arriscar mostrar a cor errada (ex:
  // um escore "alto" que na verdade indica sintoma clínico, não desempenho bom).
  direcao                   DirecaoMelhorPior @default(NEUTRO)

  tabelasNormativas         TabelaNormativa[]
  normativasCustomizadas    NormativaCustomizada[]
  aplicacoes                AplicacaoDeTeste[]

  criadoEm                  DateTime          @default(now())
}

// Tabela normativa flexível: cada linha é uma faixa (ex: idade 8-9 anos) com o critério de conversão
model TabelaNormativa {
  id            String   @id @default(uuid())
  testeId       String
  teste         Teste    @relation(fields: [testeId], references: [id])

  criterio      String   // ex: "idade", "idade+sexo", "idade+escolaridade"
  faixaMin      Float?
  faixaMax      Float?
  faixaLabel    String?  // ex: "6º ao 9º ano" quando não é numérico
  sexo          Sexo?    // preenchido só quando o critério estratifica por sexo (ex: ETDAH-PAIS)
  conversao     Json     // mapeamento escore bruto -> percentil/escore padronizado/classificação
}

// Normativa customizada — clínica pode fazer upload de suas próprias tabelas
// Sobrescreve TabelaNormativa para esse teste na clínica específica
model NormativaCustomizada {
  id            String   @id @default(uuid())
  clinicaId     String
  clinica       Clinica  @relation(fields: [clinicaId], references: [id])
  testeId       String
  teste         Teste    @relation(fields: [testeId], references: [id])

  nomeNormativa String   // ex: "Amostra brasileira 2020 - adaptação local"
  descricao     String?  @db.Text
  fonte         String?  // ex: "Universidade X" ou "Pesquisa em andamento"

  criterio      String   // ex: "idade", "idade+sexo"
  faixaMin      Float?
  faixaMax      Float?
  faixaLabel    String?
  sexo          Sexo?
  conversao     Json     // tabela de conversão (mesma estrutura de TabelaNormativa)

  ativo         Boolean  @default(true) // Clínica pode desativar sem deletar
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  @@unique([clinicaId, testeId, criterio, faixaLabel]) // Evita duplicatas
}

model AplicacaoDeTeste {
  id                String    @id @default(uuid())
  sessaoId          String
  sessao            Sessao    @relation(fields: [sessaoId], references: [id])
  testeId           String
  teste             Teste     @relation(fields: [testeId], references: [id])

  escoresBrutos     Json      // estrutura varia por teste
  resultadoCalculado Json?    // percentil, escore padronizado, classificação, gráfico-ready
  calculadoEm       DateTime?

  // Quem respondeu — ver enum TipoRespondente. Não há restrição de unicidade em
  // (sessaoId, testeId) de propósito: a MESMA sessão pode ter o mesmo teste respondido por
  // várias pessoas, e é justamente isso que permite a comparação entre informantes.
  //
  // Default PACIENTE mantém o comportamento de todo lançamento já existente e de todo teste de
  // aplicação direta, onde não há informante.
  respondenteTipo   TipoRespondente @default(PACIENTE)
  // Nome de quem respondeu e o vínculo com o paciente, quando o respondente não é ele próprio.
  // A relação é texto livre porque o enum não dá conta do que aparece na prática ("avó materna",
  // "professora de matemática", "educadora do contraturno").
  respondenteNome     String?
  respondenteRelacao  String?

  criadoEm          DateTime  @default(now())
}

model Laudo {
  id                String       @id @default(uuid())
  pacienteId        String
  paciente          Paciente     @relation(fields: [pacienteId], references: [id])
  profissionalId    String
  profissional      Profissional @relation(fields: [profissionalId], references: [id])

  // 6 seções obrigatórias — Resolução CFP nº 06/2019
  identificacao     Json         // dados do solicitante/paciente/profissional
  descricaoDemanda  String       @db.Text
  procedimento      String       @db.Text  // testes usados, nº de sessões, datas
  analise           String       @db.Text  // gerado por IA como rascunho, depois editado
  conclusao         String       @db.Text
  referencias       String       @db.Text
  anamnese          String       @default("") @db.Text // seção 3 do modelo completo de laudo
  observacaoClinica String       @default("") @db.Text // seção 4
  interpretacoes    Json?        // interpretação do profissional por domínio ({ "executivas": "texto", … }); sobrevive a "montar de novo"
  hipoteseDiagnostica String     @default("") @db.Text // parágrafo "Hipótese diagnóstica" (com CID), no fim da conclusão
  modeloId          String?      // modelo de laudo usado (estrutura das seções); sem ele vale o padrão do profissional, da clínica ou do sistema
  modelo            ModeloLaudo? @relation(fields: [modeloId], references: [id])
  secoesExtras      Json?        // texto por paciente das seções livres do modelo ({ "<id da seção>": "texto" })

  status            StatusLaudo  @default(RASCUNHO_IA)
  dataDevolutiva    DateTime?
  arquivoUrl        String?      // DOCX/PDF final gerado

  // Conformidade Resolução CFP nº 09/2024 (TDICs) + Cartilha CFP sobre IA (dez/2025):
  // uso de IA precisa ser transparente ao paciente e registrado, responsabilidade sempre do profissional
  iaUtilizada         Boolean    @default(false)
  iaRevisadaPeloProf  Boolean    @default(false)  // trava de segurança: não finaliza sem revisão humana marcada

  criadoEm          DateTime     @default(now())
  atualizadoEm      DateTime     @updatedAt
}

// Tipo de atendimento (modelo, template) — ex: "Laudo de Avaliação Neuropsicológica"
// Agrupa número de sessões + lista de testes obrigatórios para facilitar criação de atendimentos
model TipoAtendimento {
  id                String   @id @default(uuid())
  clinicaId         String
  clinica           Clinica  @relation(fields: [clinicaId], references: [id])

  nome              String   // ex: "Laudo de Avaliação Neuropsicológica"
  descricao         String?  @db.Text
  numeroSessoes     Int      @default(1)
  testeIds          String[] @default([]) // IDs dos testes associados (Teste.id)

  criadoEm          DateTime @default(now())
  atualizadoEm      DateTime @updatedAt

  @@unique([clinicaId, nome]) // Um nome de tipo por clínica
}

// Sala virtual para telepsicologia — Resolução CFP nº 11/2018 + nº 09/2024
// Usa Jitsi Meet (open source, criptografado ponta-a-ponta, sem armazenamento)
model SalaVirtual {
  id                String    @id @default(uuid())
  sessaoId          String
  sessao            Sessao    @relation(fields: [sessaoId], references: [id])

  // URL de acesso (gerada automaticamente — formato Jitsi: https://meet.jit.si/NomeUnico)
  urlJitsi          String    @unique
  codigoSala        String    @unique  // Identificador único para Jitsi (ex: neurologic-{uuid})

  provedor          String    @default("JITSI") // JITSI (sala pública antiga) | LIVEKIT (chamada dentro do sistema)
  segredoPaciente   String?   // parte secreta do link que o paciente recebe (32 bytes aleatórios, base64url)
  consentimentos    ConsentimentoGravacao[]

  statusSala        String    @default("agendada") // agendada, em_andamento, encerrada
  inicioAgendado    DateTime  // Quando a sessão estava marcada
  inicioReal        DateTime? // Quando entrou de fato
  fimReal           DateTime? // Quando saiu

  // Registro para conformidade CFP 11/2018
  profissionalPresente  Boolean @default(false)
  pacientePresente      Boolean @default(false)

  criadoEm          DateTime  @default(now())
  atualizadoEm      DateTime  @updatedAt
}

// --- Módulo de convênio (V2/V3 — deixado previsto no schema, não implementar ainda) ---

model Convenio {
  id             String    @id @default(uuid())
  clinicaId      String
  clinica        Clinica   @relation(fields: [clinicaId], references: [id])

  nomeOperadora  String    // ex: "Amil"
  codigoPrestador String?
  // dados para faturar o convênio (tomador da nota e regras de fechamento)
  cnpj           String?
  razaoSocial    String?
  registroAns    String?   // registro da operadora na ANS
  formaFaturamento String? // INDIVIDUAL (nota caso a caso) | LOTE_MENSAL (junta os casos do mês); vazio = o padrão da configuração fiscal
  diaFechamento  Int?      // dia do mês em que o faturamento fecha
  prazoPagamentoDias Int?
  exigeTiss      Boolean   @default(false) // envia guias/lote em XML TISS
  observacoesFaturamento String? @db.Text
  ativo          Boolean   @default(true) // desativar em vez de apagar: pacientes antigos continuam apontando para ele
  pacientes      Paciente[]
  cobrancas      Cobranca[]
  profissionais  ProfissionalConvenio[]
  tabelaValores  TabelaValorConvenio[]

  @@unique([clinicaId, nomeOperadora])
}

model ProfissionalConvenio {
  id              String       @id @default(uuid())
  profissionalId  String
  profissional    Profissional @relation(fields: [profissionalId], references: [id])
  convenioId      String
  convenio        Convenio     @relation(fields: [convenioId], references: [id])
}

model TabelaValorConvenio {
  id            String    @id @default(uuid())
  convenioId    String
  convenio      Convenio  @relation(fields: [convenioId], references: [id])
  codigoTUSS    String
  descricao     String
  valor         Decimal
}

// Valor a receber por um atendimento. Particular = sem convênio; com convênio, o valor é o que a operadora paga.
// Cancelar não apaga (status CANCELADA): o histórico financeiro fica.
model Cobranca {
  id             String    @id @default(uuid())
  clinicaId      String
  pacienteId     String
  paciente       Paciente  @relation(fields: [pacienteId], references: [id])
  sessaoId       String?
  sessao         Sessao?   @relation(fields: [sessaoId], references: [id])
  convenioId     String?
  convenio       Convenio? @relation(fields: [convenioId], references: [id])

  descricao      String
  valor          Decimal   @db.Decimal(10, 2)
  vencimento     DateTime  @db.Date
  status         String    @default("ABERTA") // ABERTA | PAGA | CANCELADA

  valorPago      Decimal?  @db.Decimal(10, 2) // menor que o valor = glosa/desconto (a diferença fica visível)
  pagoEm         DateTime? @db.Date
  formaPagamento String?   // pix, dinheiro, cartão, transferência, repasse do convênio...
  // dados de convênio (guia/lote) e vínculo com a nota fiscal
  numeroGuia     String?
  senhaAutorizacao String?
  codigoTuss     String?
  notaFiscalId   String?
  notaFiscal     NotaFiscal? @relation(fields: [notaFiscalId], references: [id])
  observacoes    String?   @db.Text

  criadoEm       DateTime  @default(now())
  atualizadoEm   DateTime  @updatedAt

  @@index([clinicaId, status, vencimento])
  @@index([pacienteId])
}

// Modelo de laudo/documento: estrutura de seções, textos fixos, mapa de domínios e blocos. Os do SISTEMA (sistema=true, clinicaId nulo) são
// somente leitura: quem quer mudar algo grava uma cópia com outro nome (origemId aponta para o modelo de partida). `padrao` marca o modelo
// que cada profissional (Profissional.modeloLaudoPadraoId) ou a clínica (Clinica.modeloLaudoPadraoId) usa por padrão.
model ModeloLaudo {
  id             String        @id @default(uuid())
  clinicaId      String?
  clinica        Clinica?      @relation(fields: [clinicaId], references: [id])
  profissionalId String?
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])

  nome           String
  tipo           String        // LAUDO_NEURO | LAUDO | RELATORIO | PARECER | DECLARACAO | ATESTADO | PERSONALIZADO
  descricao      String?       @db.Text
  fonte          String?       // de onde veio a estrutura (resolução/manual citado)
  sistema        Boolean       @default(false)
  origemId       String?
  estrutura      Json
  arquivoDocx    String?       @db.Text // modelo Word com marcadores {{...}} (base64), quando a clínica sobe o próprio
  ativo          Boolean       @default(true)

  laudos         Laudo[]
  criadoEm       DateTime      @default(now())
  atualizadoEm   DateTime      @updatedAt
}

// Resumo do Painel do Dia guardado por profissional e por dia (data = AAAA-MM-DD no fuso de São Paulo). `assinatura` identifica o que entrou no
// resumo (agenda do dia e revisões pendentes): se mudou, o resumo é refeito; se não, a IA não é chamada de novo a cada abertura do painel.
model ResumoDoDia {
  id             String   @id @default(uuid())
  profissionalId String
  data           String
  conteudo       String   @db.Text
  assinatura     String
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@unique([profissionalId, data])
}

// Configuração fiscal da clínica (NFS-e). Tudo é configurável: nada de município, código de serviço, alíquota ou texto fixo no código.
model ConfigFiscal {
  id             String   @id @default(uuid())
  clinicaId      String   @unique
  clinica        Clinica  @relation(fields: [clinicaId], references: [id])

  emissaoAtiva   Boolean  @default(false) // enquanto desligada, o sistema só prepara (rascunho); não emite
  ambiente       String   @default("HOMOLOGACAO") // HOMOLOGACAO | PRODUCAO
  regime         String   @default("SIMPLES_NACIONAL") // SIMPLES_NACIONAL | MEI | LUCRO_PRESUMIDO | LUCRO_REAL
  inscricaoMunicipal String?
  codigoMunicipioIbge String?
  localPrestacaoIbge String? // vazio = o município da clínica

  // serviço
  cTribNac       String?  // código de tributação nacional (ex.: 04.16.01)
  nbs            String?
  descricaoPadrao String  @default("Prestação de serviços em atendimento de Psicologia {{sessao.data}}") @db.Text

  // imposto
  aliquotaModo   String   @default("FIXA") // FIXA | SIMPLES (calculada pela receita dos últimos 12 meses)
  aliquotaIss    Decimal? @db.Decimal(5, 2)
  rbt12          Decimal? @db.Decimal(14, 2)
  issRetido      Boolean  @default(false)
  anexoSimples   String   @default("3") // anexo do Simples dos SERVIÇOS (3 ou 5)
  regApuracaoSn  String   @default("1") // 1 = ISS e federais recolhidos no DAS; 2/3 = ISS apurado por fora
  regimeEspecial String   @default("0") // 0 = nenhum

  // certificado digital A1: o .pfx e a senha ficam CIFRADOS (AES-256-GCM, chave FISCAL_CRYPTO_KEY do servidor); nunca voltam para a tela
  certificadoCifrado String? @db.Text
  certificadoSenhaCifrada String?
  certificadoTitular String?
  certificadoValidoAte DateTime?

  // numeração (a série e o próximo número seguem o que já foi emitido fora do sistema)
  serieDps       String   @default("1")
  proximoNumeroDps Int    @default(1)

  // quando e como emitir
  modoParticular String   @default("POR_SESSAO") // POR_SESSAO | POR_LAUDO | MANUAL
  quandoEmitir   String   @default("MANUAL") // NA_BAIXA (ao receber) | NA_COBRANCA | MANUAL
  modoConvenio   String   @default("INDIVIDUAL") // INDIVIDUAL | LOTE_MENSAL (cada convênio pode mudar)
  exigeDataPagamento Boolean @default(true)

  atualizadoEm   DateTime @updatedAt
}

// Nota fiscal de serviço (rascunho, emitida, rejeitada ou cancelada). O tomador é gravado como estava na emissão.
model NotaFiscal {
  id             String   @id @default(uuid())
  clinicaId      String
  clinica        Clinica  @relation(fields: [clinicaId], references: [id])

  origem         String   // SESSAO | LAUDO | CONVENIO_CASO | CONVENIO_LOTE | MANUAL
  status         String   @default("RASCUNHO") // RASCUNHO | EMITIDA | REJEITADA | PENDENTE (enviada sem resposta: conferir no Portal) | CANCELADA
  ambiente       String   @default("HOMOLOGACAO")
  serie          String?
  numero         Int?
  competencia    DateTime @db.Date

  tomadorNome    String
  tomadorDocumento String?
  tomadorConvenioId String?
  tomadorEndereco Json?

  valor          Decimal  @db.Decimal(10, 2)
  descricao      String   @db.Text
  datasServico   Json?    // datas das sessões cobertas

  chaveAcesso    String?
  protocolo      String?
  erro           String?  @db.Text
  numeroNfse     String?  // número da NFS-e autorizada (pode diferir do número da DPS)
  xmlDps         String?  @db.Text
  xmlNfse        String?  @db.Text
  tentativas     Int      @default(0)
  avisos         Json?
  emitidaEm      DateTime?

  cobrancas      Cobranca[]
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  @@unique([clinicaId, ambiente, serie, numero])
  @@index([clinicaId, status, competencia])
}

// Consentimento do paciente (ou do responsável) para gravar a sessão e para tratar a gravação com IA (transcrição e resumo).
// Cada resposta é um registro próprio, com a versão do texto que foi mostrado, quem respondeu, quando e de onde. Revogar não apaga:
// preenche revogadoEm. Sem um consentimento de GRAVACAO concedido e não revogado, a gravação não pode começar.
model ConsentimentoGravacao {
  id            String       @id @default(uuid())
  salaId        String
  sala          SalaVirtual  @relation(fields: [salaId], references: [id])
  sessaoId      String

  tipo          String       // GRAVACAO | TRANSCRICAO_IA
  concedido     Boolean
  declaradoPor  String       // PACIENTE | RESPONSAVEL
  nomeDeclarante String
  versaoTexto   String
  ip            String?
  userAgent     String?
  criadoEm      DateTime     @default(now())
  revogadoEm    DateTime?

  @@index([salaId, tipo])
}
